<?xml version="1.0"?>
<sdf version="1.9">
  <model name="kki_payload_A">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>true</allow_auto_disable>
    <link name="payload_link">
      <inertial>
        <mass>0.20</mass>
        <inertia>
          <ixx>0.00022</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00018</iyy>
          <iyz>0</iyz>
          <izz>0.00006</izz>
        </inertia>
      </inertial>
      <velocity_decay>
        <linear>1.8</linear>
        <angular>2.4</angular>
      </velocity_decay>

      <!-- Official KKI payload approximation:
           front plate 5 cm x 10 cm x 0.6 cm, QR 4 cm x 4 cm on the side,
           and an upper enlarged hanging hole. The collision is split so the
           hook peg can enter the opening instead of hitting a solid box. -->
      <collision name="plate_lower_collision">
        <pose>0 0 -0.022 0 0 0</pose>
        <geometry><box><size>0.006 0.050 0.056</size></box></geometry>
        <surface>
          <friction><ode><mu>1.7</mu><mu2>1.7</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000</threshold></bounce>
          <contact><ode><kp>30000</kp><kd>80</kd></ode></contact>
        </surface>
      </collision>
      <collision name="plate_top_collision">
        <pose>0 0 0.046 0 0 0</pose>
        <geometry><box><size>0.006 0.050 0.008</size></box></geometry>
        <surface>
          <friction><ode><mu>1.7</mu><mu2>1.7</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000</threshold></bounce>
          <contact><ode><kp>30000</kp><kd>80</kd></ode></contact>
        </surface>
      </collision>
      <collision name="plate_left_hole_side_collision">
        <pose>0 -0.020 0.0235 0 0 0</pose>
        <geometry><box><size>0.006 0.010 0.034</size></box></geometry>
        <surface>
          <friction><ode><mu>1.7</mu><mu2>1.7</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000</threshold></bounce>
          <contact><ode><kp>30000</kp><kd>80</kd></ode></contact>
        </surface>
      </collision>
      <collision name="plate_right_hole_side_collision">
        <pose>0 0.020 0.0235 0 0 0</pose>
        <geometry><box><size>0.006 0.010 0.034</size></box></geometry>
        <surface>
          <friction><ode><mu>1.7</mu><mu2>1.7</mu2><slip1>0.02</slip1><slip2>0.02</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000</threshold></bounce>
          <contact><ode><kp>30000</kp><kd>80</kd></ode></contact>
        </surface>
      </collision>
      <collision name="base_foot_collision">
        <pose>0.012 0 -0.053 0 0 0</pose>
        <geometry><box><size>0.030 0.050 0.006</size></box></geometry>
        <surface>
          <friction><ode><mu>1.9</mu><mu2>1.9</mu2><slip1>0.015</slip1><slip2>0.015</slip2></ode></friction>
          <bounce><restitution_coefficient>0.0</restitution_coefficient><threshold>1000</threshold></bounce>
          <contact><ode><kp>35000</kp><kd>90</kd></ode></contact>
        </surface>
      </collision>

      <visual name="plate_lower_visual">
        <pose>0 0 -0.022 0 0 0</pose>
        <geometry><box><size>0.006 0.050 0.056</size></box></geometry>
        <material>
          <ambient>0.90 0.12 0.10 1</ambient>
          <diffuse>0.90 0.12 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="plate_top_visual">
        <pose>0 0 0.046 0 0 0</pose>
        <geometry><box><size>0.006 0.050 0.008</size></box></geometry>
        <material>
          <ambient>0.90 0.12 0.10 1</ambient>
          <diffuse>0.90 0.12 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="plate_left_hole_side_visual">
        <pose>0 -0.020 0.0235 0 0 0</pose>
        <geometry><box><size>0.006 0.010 0.034</size></box></geometry>
        <material>
          <ambient>0.90 0.12 0.10 1</ambient>
          <diffuse>0.90 0.12 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="plate_right_hole_side_visual">
        <pose>0 0.020 0.0235 0 0 0</pose>
        <geometry><box><size>0.006 0.010 0.034</size></box></geometry>
        <material>
          <ambient>0.90 0.12 0.10 1</ambient>
          <diffuse>0.90 0.12 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="base_foot_visual">
        <pose>0.012 0 -0.053 0 0 0</pose>
        <geometry><box><size>0.030 0.050 0.006</size></box></geometry>
        <material>
          <ambient>0.90 0.12 0.10 1</ambient>
          <diffuse>0.90 0.12 0.10 1</diffuse>
        </material>
      </visual>
      <visual name="qr_white_backing">
        <pose>-0.0038 0 -0.023 0 -1.5708 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.043 0.043</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <visual name="qr_side">
        <pose>-0.0041 0 -0.023 0 -1.5708 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.040 0.040</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://kki_payload_A/materials/textures/qr_A.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
