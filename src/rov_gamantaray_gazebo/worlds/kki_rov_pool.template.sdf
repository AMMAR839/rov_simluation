<?xml version="1.0"?>
<sdf version="1.9">
  <world name="kki_rov_pool">
    <physics name="underwater_physics" type="ode">
      <max_step_size>@PHYSICS_STEP_SIZE@</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    @HYDRO_WORLD_PLUGINS@

    <scene>
      <ambient>0.07 0.16 0.19 1</ambient>
      <background>0.005 0.030 0.045 1</background>
      <grid>false</grid>
      <fog>
        <type>linear</type>
        <color>0.02 0.13 0.16 1</color>
        <start>1.8</start>
        <end>8.5</end>
        <density>0.08</density>
      </fog>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.62 0.82 0.92 1</diffuse>
      <specular>0.55 0.70 0.75 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <light type="point" name="pool_fill_light">
      <pose>0 0 1.4 0 0 0</pose>
      <diffuse>0.12 0.46 0.58 1</diffuse>
      <specular>0.28 0.52 0.60 1</specular>
      <attenuation>
        <range>12</range>
        <linear>0.06</linear>
        <constant>0.35</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="pool_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 10.0 0.06</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.0 10.0 0.06</size></box></geometry>
          <material><ambient>0.38 0.50 0.55 1</ambient><diffuse>0.42 0.58 0.63 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 -0.88 0 0 0</pose>
    </model>

    <model name="pool_floor_markings">
      <static>true</static>
      <pose>0 0 -0.842 0 0 0</pose>
      <link name="link">
