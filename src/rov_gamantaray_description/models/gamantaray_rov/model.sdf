      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
      </sensor>
      <sensor name="wall_camera" type="camera">
        <pose>0.19 0 -0.01 0 0 0</pose>
