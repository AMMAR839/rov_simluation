<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamantaray_rov_hydro">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>13.95</mass>
        <pose>0 0 -0.045 0 0 0</pose>
        <inertia>
          <ixx>0.26</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.32</iyy>
          <iyz>0</iyz>
          <izz>0.42</izz>
        </inertia>
      </inertial>

      <collision name="buoyancy_body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.28 0.16</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://gamantaray_rov/meshes/bluerov2_noprop.dae</uri>
            <scale>0.82 0.82 0.82</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="thruster1_prop_visual">
        <pose>0.1150 -0.1050 -0.0350 0 1.5708 0.7854</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>
      <visual name="thruster2_prop_visual">
        <pose>0.1150 0.1050 -0.0350 0 1.5708 -0.7854</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>
      <visual name="thruster3_prop_visual">
        <pose>-0.1150 -0.1050 -0.0350 0 1.5708 2.3562</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>
      <visual name="thruster4_prop_visual">
        <pose>-0.1150 0.1050 -0.0350 0 1.5708 -2.3562</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>
      <visual name="thruster5_prop_visual">
        <pose>0.0200 -0.0950 0.0050 0 0 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>
      <visual name="thruster6_prop_visual">
        <pose>0.0200 0.0950 0.0050 0 0 0</pose>
        <geometry><cylinder><radius>0.026</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.018 0.022 0.024 1</ambient><diffuse>0.025 0.032 0.036 1</diffuse></material>
      </visual>

      <visual name="gripper_mount_body">
        <pose>0.218 0 -0.112 0 0 0</pose>
        <geometry><box><size>0.055 0.112 0.050</size></box></geometry>
        <material><ambient>0.020 0.022 0.024 1</ambient><diffuse>0.030 0.034 0.038 1</diffuse><specular>0.22 0.24 0.26 1</specular></material>
      </visual>
      <visual name="gripper_cross_pin">
        <pose>0.258 0 -0.136 1.5707963268 0 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.135</length></cylinder></geometry>
        <material><ambient>0.11 0.12 0.12 1</ambient><diffuse>0.18 0.19 0.18 1</diffuse><specular>0.45 0.45 0.42 1</specular></material>
      </visual>
      <visual name="wall_camera_housing">
        <pose>0.20 0 -0.01 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.018</radius><length>0.028</length></cylinder></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="bottom_camera_housing">
        <pose>0.03 0 -0.105 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
      </sensor>
      <sensor name="wall_camera" type="camera">
        <pose>0.19 0 -0.01 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/wall/image</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>12.0</far></clip>
        </camera>
      </sensor>
      <sensor name="bottom_camera" type="camera">
        <pose>0.03 0 -0.11 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/bottom/image</topic>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>6.0</far></clip>
        </camera>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <disable_coriolis>true</disable_coriolis>
      <xDotU>-0.8</xDotU>
      <yDotV>-1.5</yDotV>
      <zDotW>-1.8</zDotW>
      <kDotP>-0.02</kDotP>
      <mDotQ>-0.02</mDotQ>
      <nDotR>-0.02</nDotR>
      <xU>-10.0</xU>
      <yV>-10.0</yV>
      <zW>-12.0</zW>
      <kP>-1.0</kP>
      <mQ>-1.0</mQ>
      <nR>-1.0</nR>
      <xUabsU>-20.0</xUabsU>
      <yVabsV>-35.0</yVabsV>
      <zWabsW>-35.0</zWabsW>
      <kPabsP>-0.3</kPabsP>
      <mQabsQ>-0.3</mQabsQ>
      <nRabsR>-0.3</nRabsR>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <dimensions>3</dimensions>
      <robot_base_frame>gamantaray_rov/base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
