      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
      </sensor>
      <sensor name="wall_camera" type="camera">
        <pose>0.19 0 -0.01 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/wall/image</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>12.0</far></clip>
        </camera>
      </sensor>
      <sensor name="bottom_camera" type="camera">
        <pose>0.03 0 -0.11 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/bottom/image</topic>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>6.0</far></clip>
        </camera>
      </sensor>
    </link>

    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <disable_coriolis>true</disable_coriolis>
      <xDotU>-0.8</xDotU>
      <yDotV>-1.5</yDotV>
      <zDotW>-1.8</zDotW>
      <kDotP>-0.02</kDotP>
      <mDotQ>-0.02</mDotQ>
      <nDotR>-0.02</nDotR>
      <xU>-10.0</xU>
      <yV>-10.0</yV>
      <zW>-12.0</zW>
      <kP>-1.0</kP>
      <mQ>-1.0</mQ>
      <nR>-1.0</nR>
      <xUabsU>-20.0</xUabsU>
      <yVabsV>-35.0</yVabsV>
      <zWabsW>-35.0</zWabsW>
      <kPabsP>-0.3</kPabsP>
      <mQabsQ>-0.3</mQabsQ>
      <nRabsR>-0.3</nRabsR>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <dimensions>3</dimensions>
      <robot_base_frame>gamantaray_rov/base_link</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
