      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-0.46</lower><upper>-0.035</upper><effort>8.0</effort><velocity>2.5</velocity></limit>
        <dynamics><damping>0.08</damping><friction>0.02</friction></dynamics>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>left_gripper_hinge</joint_name>
      <topic>/model/gamantaray_rov/joint/left_gripper_hinge/0/cmd_pos</topic>
      <p_gain>7.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.18</d_gain>
      <cmd_max>4.5</cmd_max>
      <cmd_min>-4.5</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>right_gripper_hinge</joint_name>
      <topic>/model/gamantaray_rov/joint/right_gripper_hinge/0/cmd_pos</topic>
      <p_gain>7.5</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.18</d_gain>
      <cmd_max>4.5</cmd_max>
      <cmd_min>-4.5</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_gripper_hinge</joint_name>
      <joint_name>right_gripper_hinge</joint_name>
      <topic>/model/gamantaray_rov/gripper_joint_state</topic>
    </plugin>

    <link name="sensor_link">
      <pose>0 0 0 0 0 0</pose>
      <visual name="front_camera_glass">
        <pose>0.165 0 0.052 0 1.5707963268 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.04 0.05 1</ambient>
          <diffuse>0.04 0.10 0.12 1</diffuse>
          <specular>0.80 0.95 1.00 1</specular>
        </material>
      </visual>

      <visual name="bottom_camera_housing">
        <pose>0.025 0 -0.095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.016</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
      </sensor>

      <sensor name="wall_camera" type="camera">
        <pose>0.165 0 0.052 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/wall/image</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="bottom_camera" type="camera">
        <pose>0.025 0 -0.105 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/bottom/image</topic>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>6.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="sensor_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_link</child>
    </joint>
  </model>
</sdf>
