<?xml version="1.0"?>
<sdf version="1.9">
  <model name="gamantaray_rov_github_blue_gripper">
    <static>true</static>
    <self_collide>false</self_collide>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>13.0</mass>
        <pose>0 0 0.011 0 0 0</pose>
        <inertia>
          <ixx>0.099</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.178</iyy>
          <iyz>0</iyz>
          <izz>0.269</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.35 0.26 0.14</size>
          </box>
        </geometry>
      </collision>

      <visual name="github_blue_body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://gamantaray_rov_github_blue_gripper/meshes/bluerov2.dae</uri>
            <scale>0.0192 0.0192 0.0192</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="gripper_wrist_housing">
        <pose>0.242 0 -0.134 0 1.5707963268 0</pose>
        <geometry>
          <mesh>
            <uri>model://gamantaray_rov_github_blue_gripper/meshes/arm_link5.stl</uri>
            <scale>0.78 0.78 0.78</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.015 0.016 0.018 1</ambient>
          <diffuse>0.026 0.028 0.031 1</diffuse>
          <specular>0.26 0.28 0.30 1</specular>
        </material>
      </visual>

      <visual name="gripper_mount_plate">
        <pose>0.220 0 -0.122 0 0 0</pose>
        <geometry>
          <box>
            <size>0.044 0.135 0.026</size>
          </box>
        </geometry>
        <material>
          <ambient>0.012 0.014 0.016 1</ambient>
          <diffuse>0.024 0.028 0.032 1</diffuse>
          <specular>0.22 0.24 0.26 1</specular>
        </material>
      </visual>

      <visual name="gripper_cross_pin">
        <pose>0.258 0 -0.135 1.5707963268 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.145</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.10 0.11 0.11 1</ambient>
          <diffuse>0.18 0.19 0.19 1</diffuse>
          <specular>0.45 0.45 0.42 1</specular>
        </material>
      </visual>

      <visual name="front_camera_glass">
        <pose>0.165 0 0.052 0 1.5707963268 0</pose>
        <geometry>
          <cylinder>
            <radius>0.020</radius>
            <length>0.012</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.04 0.05 1</ambient>
          <diffuse>0.04 0.10 0.12 1</diffuse>
          <specular>0.80 0.95 1.00 1</specular>
        </material>
      </visual>

      <visual name="bottom_camera_housing">
        <pose>0.025 0 -0.095 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.016</radius>
            <length>0.018</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/rov/imu</topic>
      </sensor>

      <sensor name="wall_camera" type="camera">
        <pose>0.165 0 0.052 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/wall/image</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>12.0</far>
          </clip>
        </camera>
      </sensor>

      <sensor name="bottom_camera" type="camera">
        <pose>0.025 0 -0.105 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
        <topic>/rov/camera/bottom/image</topic>
        <camera>
          <horizontal_fov>1.35</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>6.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
